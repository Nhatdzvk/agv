<?xml version="1.0"?>

<robot
  name="factory_delivery_amr"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================================================================ -->
  <!-- PARAMETERS                                                       -->
  <!-- Units: meters, kilograms, radians                                -->
  <!-- ================================================================ -->

  <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

  <!-- Main drive wheels -->
  <xacro:property name="wheel_radius" value="0.110"/>
  <xacro:property name="wheel_width" value="0.060"/>
  <xacro:property name="wheel_separation" value="0.620"/>

  <!-- Caster positions and collision geometry -->
  <xacro:property name="caster_x_offset" value="0.310"/>
  <xacro:property name="caster_y_offset" value="0.245"/>

  <!--
    Main-wheel ground contact:
      center Z = 0.110
      radius   = 0.110
      bottom Z = 0.000

    Caster ground contact:
      center Z = 0.035
      radius   = 0.035
      bottom Z = 0.000
  -->

  <xacro:property name="caster_collision_radius" value="0.035"/>
  <xacro:property name="caster_collision_z" value="0.035"/>

  <!-- Lift mechanism -->
  <xacro:property name="lift_x" value="-0.015"/>
  <xacro:property name="lift_lowered_z" value="0.330"/>
  <xacro:property name="lift_travel" value="0.180"/>

  <!-- Scissor mechanism -->
  <xacro:property name="scissor_bar_length" value="0.273"/>
  <xacro:property name="scissor_bar_width" value="0.016"/>
  <xacro:property name="scissor_bar_height" value="0.016"/>

  <xacro:property name="scissor_center_x" value="-0.015"/>
  <xacro:property name="scissor_x_offset" value="0.135"/>
  <xacro:property name="scissor_lower_z" value="0.268"/>

  <xacro:property name="scissor_y_outer" value="0.112"/>
  <xacro:property name="scissor_y_inner" value="0.098"/>


  <!-- ================================================================ -->
  <!-- MATERIALS                                                        -->
  <!-- ================================================================ -->

  <material name="dark_blue">
    <color rgba="0.10 0.26 0.48 1.0"/>
  </material>

  <material name="metal_gray">
    <color rgba="0.55 0.58 0.62 1.0"/>
  </material>

  <material name="silver">
    <color rgba="0.82 0.84 0.88 1.0"/>
  </material>

  <material name="wheel_black">
    <color rgba="0.10 0.10 0.12 1.0"/>
  </material>

  <material name="lift_orange">
    <color rgba="0.92 0.58 0.08 1.0"/>
  </material>

  <material name="payload_brown">
    <color rgba="0.72 0.52 0.32 1.0"/>
  </material>

  <material name="lidar_dark">
    <color rgba="0.10 0.11 0.14 1.0"/>
  </material>

  <material name="camera_gray">
    <color rgba="0.72 0.75 0.78 1.0"/>
  </material>

  <material name="scissor_orange">
    <color rgba="0.82 0.48 0.08 1.0"/>
  </material>


  <!-- ================================================================ -->
  <!-- BASE FRAMES                                                      -->
  <!-- ================================================================ -->

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin
      xyz="0 0 0"
      rpy="0 0 0"/>
  </joint>


  <link name="base_link">

    <inertial>
      <origin
        xyz="0 0 0.145"
        rpy="0 0 0"/>

      <mass value="40.0"/>

      <inertia
        ixx="2.0"
        ixy="0.0"
        ixz="0.0"
        iyy="2.7"
        iyz="0.0"
        izz="4.2"/>
    </inertial>

    <!--
      Bottom of this collision:
      0.1675 - 0.265 / 2 = 0.035 m

      Therefore the chassis collision remains 35 mm above ground.
    -->

    <collision name="base_collision">
      <origin
        xyz="0 0 0.1675"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.850 0.720 0.265"/>
      </geometry>
    </collision>

  </link>


  <!-- ================================================================ -->
  <!-- FIXED MESH LINK MACRO                                            -->
  <!-- ================================================================ -->

  <xacro:macro
    name="fixed_mesh_link"
    params="link_name joint_name mesh_file material_name">

    <link name="${link_name}">

      <visual name="${link_name}_visual">
        <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

        <geometry>
          <mesh
            filename="package://factory_delivery_amr_description/meshes/${mesh_file}"
            scale="${mesh_scale}"/>
        </geometry>

        <material name="${material_name}"/>
      </visual>

    </link>

    <joint name="${joint_name}" type="fixed">
      <parent link="base_link"/>
      <child link="${link_name}"/>

      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>
    </joint>

  </xacro:macro>


  <!-- ================================================================ -->
  <!-- CASTER COLLISION MACRO                                           -->
  <!--                                                                  -->
  <!-- The detailed caster appearance remains inside casters_visual.stl.-->
  <!-- This macro creates one spherical physical contact per caster.    -->
  <!-- ================================================================ -->

  <xacro:macro
    name="caster_collision"
    params="link_name joint_name x y">

    <link name="${link_name}">

      <collision name="${link_name}_collision">
        <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

        <geometry>
          <sphere radius="${caster_collision_radius}"/>
        </geometry>
      </collision>

      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0"/>

        <mass value="0.20"/>

        <inertia
          ixx="0.000098"
          ixy="0.0"
          ixz="0.0"
          iyy="0.000098"
          iyz="0.0"
          izz="0.000098"/>
      </inertial>

    </link>

    <joint name="${joint_name}" type="fixed">
      <parent link="base_link"/>
      <child link="${link_name}"/>

      <origin
        xyz="${x} ${y} ${caster_collision_z}"
        rpy="0 0 0"/>
    </joint>

  </xacro:macro>


  <!-- ================================================================ -->
  <!-- FIXED ROBOT COMPONENTS                                           -->
  <!-- ================================================================ -->

  <xacro:fixed_mesh_link
    link_name="chassis_link"
    joint_name="chassis_joint"
    mesh_file="chassis_visual.stl"
    material_name="metal_gray"/>

  <xacro:fixed_mesh_link
    link_name="body_shell_link"
    joint_name="body_shell_joint"
    mesh_file="body_shell_visual.stl"
    material_name="dark_blue"/>

  <xacro:fixed_mesh_link
    link_name="casters_link"
    joint_name="casters_joint"
    mesh_file="casters_visual.stl"
    material_name="wheel_black"/>


  <!-- ================================================================ -->
  <!-- FOUR PHYSICAL CASTER CONTACTS                                    -->
  <!-- All four caster spheres touch the ground at Z = 0.               -->
  <!-- ================================================================ -->

  <xacro:caster_collision
    link_name="caster_front_left_link"
    joint_name="caster_front_left_joint"
    x="${caster_x_offset}"
    y="${caster_y_offset}"/>

  <xacro:caster_collision
    link_name="caster_front_right_link"
    joint_name="caster_front_right_joint"
    x="${caster_x_offset}"
    y="${-caster_y_offset}"/>

  <xacro:caster_collision
    link_name="caster_rear_left_link"
    joint_name="caster_rear_left_joint"
    x="${-caster_x_offset}"
    y="${caster_y_offset}"/>

  <xacro:caster_collision
    link_name="caster_rear_right_link"
    joint_name="caster_rear_right_joint"
    x="${-caster_x_offset}"
    y="${-caster_y_offset}"/>


  <xacro:fixed_mesh_link
    link_name="battery_system_link"
    joint_name="battery_system_joint"
    mesh_file="battery_system_visual.stl"
    material_name="dark_blue"/>

  <xacro:fixed_mesh_link
    link_name="electronics_link"
    joint_name="electronics_joint"
    mesh_file="electronics_visual.stl"
    material_name="metal_gray"/>

  <xacro:fixed_mesh_link
    link_name="fixed_drive_hardware_link"
    joint_name="fixed_drive_hardware_joint"
    mesh_file="fixed_drive_hardware_visual.stl"
    material_name="metal_gray"/>

  <xacro:fixed_mesh_link
    link_name="safety_components_link"
    joint_name="safety_components_joint"
    mesh_file="safety_components_visual.stl"
    material_name="metal_gray"/>


  <!-- ================================================================ -->
  <!-- LEFT DRIVE WHEEL                                                 -->
  <!-- ================================================================ -->

  <link name="left_wheel_link">

    <visual name="left_wheel_visual">
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/left_wheel_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="wheel_black"/>
    </visual>

    <collision name="left_wheel_collision">
      <origin
        xyz="0 0 0"
        rpy="${pi / 2} 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="2.2"/>

      <inertia
        ixx="0.007315"
        ixy="0.0"
        ixz="0.0"
        iyy="0.013310"
        iyz="0.0"
        izz="0.007315"/>
    </inertial>

  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>

    <origin
      xyz="0 0.310 0.110"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      effort="80.0"
      velocity="20.0"/>

    <dynamics
      damping="0.1"
      friction="0.05"/>
  </joint>


  <!-- ================================================================ -->
  <!-- RIGHT DRIVE WHEEL                                                -->
  <!-- ================================================================ -->

  <link name="right_wheel_link">

    <visual name="right_wheel_visual">
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/right_wheel_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="wheel_black"/>
    </visual>

    <collision name="right_wheel_collision">
      <origin
        xyz="0 0 0"
        rpy="${pi / 2} 0 0"/>

      <geometry>
        <cylinder
          radius="${wheel_radius}"
          length="${wheel_width}"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

      <mass value="2.2"/>

      <inertia
        ixx="0.007315"
        ixy="0.0"
        ixz="0.0"
        iyy="0.013310"
        iyz="0.0"
        izz="0.007315"/>
    </inertial>

  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>

    <origin
      xyz="0 -0.310 0.110"
      rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      effort="80.0"
      velocity="20.0"/>

    <dynamics
      damping="0.1"
      friction="0.05"/>
  </joint>


  <!-- ================================================================ -->
  <!-- FIXED LIFT STRUCTURE                                             -->
  <!-- ================================================================ -->

  <link name="lift_fixed_link">

    <visual name="lift_fixed_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lift_fixed_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="metal_gray"/>
    </visual>

  </link>

  <joint name="lift_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lift_fixed_link"/>

    <origin
      xyz="-0.015 0 0"
      rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- MOVING LIFT PLATFORM                                             -->
  <!-- ================================================================ -->

  <link name="lift_platform_link">

    <visual name="lift_platform_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lift_platform_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="lift_orange"/>
    </visual>

    <collision name="lift_platform_collision">
      <origin
        xyz="0 0 -0.006"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.650 0.560 0.012"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 -0.010"
        rpy="0 0 0"/>

      <mass value="10.0"/>

      <inertia
        ixx="0.262"
        ixy="0.0"
        ixz="0.0"
        iyy="0.352"
        iyz="0.0"
        izz="0.614"/>
    </inertial>

  </link>

  <joint name="lift_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="lift_platform_link"/>

    <origin
      xyz="${lift_x} 0 ${lift_lowered_z}"
      rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="0.0"
      upper="${lift_travel}"
      effort="4000.0"
      velocity="0.08"/>

    <dynamics
      damping="20.0"
      friction="10.0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- MOVING CENTRAL RAM                                               -->
  <!-- ================================================================ -->

  <link name="lift_ram_link">

    <visual name="lift_ram_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lift_ram_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="silver"/>
    </visual>

    <collision name="lift_ram_collision">
      <origin
        xyz="0 0 -0.115"
        rpy="0 0 0"/>

      <geometry>
        <cylinder
          radius="0.015"
          length="0.230"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 -0.115"
        rpy="0 0 0"/>

      <mass value="2.0"/>

      <inertia
        ixx="0.0089"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0089"
        iyz="0.0"
        izz="0.000225"/>
    </inertial>

  </link>

  <joint name="lift_ram_joint" type="fixed">
    <parent link="lift_platform_link"/>
    <child link="lift_ram_link"/>

    <origin
      xyz="0 0 -0.012"
      rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- PAYLOAD                                                          -->
  <!-- ================================================================ -->

  <link name="payload_link">

    <visual name="payload_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/payload_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="payload_brown"/>
    </visual>

    <collision name="payload_collision">
      <origin
        xyz="0 0 0.027"
        rpy="0 0 0"/>

      <geometry>
        <box size="0.500 0.400 0.050"/>
      </geometry>
    </collision>

    <inertial>
      <origin
        xyz="0 0 0.027"
        rpy="0 0 0"/>

      <mass value="20.0"/>

      <inertia
        ixx="0.2708"
        ixy="0.0"
        ixz="0.0"
        iyy="0.4208"
        iyz="0.0"
        izz="0.6833"/>
    </inertial>

  </link>

  <joint name="payload_joint" type="fixed">
    <parent link="lift_platform_link"/>
    <child link="payload_link"/>

    <origin
      xyz="0 0 0.002"
      rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- LIDAR                                                            -->
  <!-- ================================================================ -->

  <link name="lidar_link">

    <visual name="lidar_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/lidar_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="lidar_dark"/>
    </visual>

  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin
      xyz="0.368 0 0.390"
      rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- CAMERA                                                           -->
  <!-- ================================================================ -->

  <link name="camera_link">

    <visual name="camera_visual">
      <geometry>
        <mesh
          filename="package://factory_delivery_amr_description/meshes/camera_visual.stl"
          scale="${mesh_scale}"/>
      </geometry>

      <material name="camera_gray"/>
    </visual>

  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin
      xyz="0.415 0 0.285"
      rpy="0 0 0"/>
  </joint>


  <!-- ================================================================ -->
  <!-- SCISSOR BAR MACRO                                                -->
  <!-- ================================================================ -->

  <xacro:macro
    name="scissor_bar"
    params="link_name joint_name joint_x joint_y rotation_z">

    <link name="${link_name}">

      <visual name="${link_name}_visual">
        <origin
          xyz="${scissor_bar_length / 2} 0 0"
          rpy="0 0 0"/>

        <geometry>
          <box
            size="${scissor_bar_length} ${scissor_bar_width} ${scissor_bar_height}"/>
        </geometry>

        <material name="scissor_orange"/>
      </visual>

      <inertial>
        <origin
          xyz="${scissor_bar_length / 2} 0 0"
          rpy="0 0 0"/>

        <mass value="0.8"/>

        <inertia
          ixx="0.000034"
          ixy="0.0"
          ixz="0.0"
          iyy="0.00499"
          iyz="0.0"
          izz="0.00499"/>
      </inertial>

    </link>

    <joint name="${joint_name}" type="revolute">
      <parent link="base_link"/>
      <child link="${link_name}"/>

      <origin
        xyz="${joint_x} ${joint_y} ${scissor_lower_z}"
        rpy="0 0 ${rotation_z}"/>

      <axis xyz="0 -1 0"/>

      <limit
        lower="0.0"
        upper="1.20"
        effort="300.0"
        velocity="1.5"/>

      <dynamics
        damping="1.0"
        friction="0.2"/>
    </joint>

  </xacro:macro>


  <!-- ================================================================ -->
  <!-- LEFT SCISSOR PAIR                                                -->
  <!-- ================================================================ -->

  <xacro:scissor_bar
    link_name="scissor_left_a_link"
    joint_name="scissor_left_a_joint"
    joint_x="${scissor_center_x - scissor_x_offset}"
    joint_y="${scissor_y_outer}"
    rotation_z="0.0"/>

  <xacro:scissor_bar
    link_name="scissor_left_b_link"
    joint_name="scissor_left_b_joint"
    joint_x="${scissor_center_x + scissor_x_offset}"
    joint_y="${scissor_y_inner}"
    rotation_z="${pi}"/>


  <!-- ================================================================ -->
  <!-- RIGHT SCISSOR PAIR                                               -->
  <!-- ================================================================ -->

  <xacro:scissor_bar
    link_name="scissor_right_a_link"
    joint_name="scissor_right_a_joint"
    joint_x="${scissor_center_x - scissor_x_offset}"
    joint_y="${-scissor_y_outer}"
    rotation_z="0.0"/>

  <xacro:scissor_bar
    link_name="scissor_right_b_link"
    joint_name="scissor_right_b_joint"
    joint_x="${scissor_center_x + scissor_x_offset}"
    joint_y="${-scissor_y_inner}"
    rotation_z="${pi}"/>


  <!-- ================================================================ -->
  <!-- GAZEBO MATERIALS AND WHEEL FRICTION                              -->
  <!-- ================================================================ -->

  <gazebo reference="body_shell_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <mu1>1.2</mu1>
    <mu2>1.2</mu2>
  </gazebo>

  <gazebo reference="lift_platform_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="payload_link">
    <material>Gazebo/Wood</material>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="scissor_left_a_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="scissor_left_b_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="scissor_right_a_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="scissor_right_b_link">
    <material>Gazebo/Orange</material>
  </gazebo>


  <!-- ================================================================ -->
  <!-- LOW-FRICTION CASTER CONTACTS                                     -->
  <!-- ================================================================ -->

  <gazebo reference="caster_front_left_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

    <minDepth>0.001</minDepth>
    <maxVel>0.10</maxVel>
  </gazebo>

  <gazebo reference="caster_front_right_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

    <minDepth>0.001</minDepth>
    <maxVel>0.10</maxVel>
  </gazebo>

  <gazebo reference="caster_rear_left_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

    <minDepth>0.001</minDepth>
    <maxVel>0.10</maxVel>
  </gazebo>

  <gazebo reference="caster_rear_right_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>

    <kp>1000000.0</kp>
    <kd>10.0</kd>

    <minDepth>0.001</minDepth>
    <maxVel>0.10</maxVel>
  </gazebo>


  <!-- ================================================================ -->
  <!-- GAZEBO FORTRESS DIFFERENTIAL DRIVE                               -->
  <!-- ================================================================ -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

      <max_linear_velocity>1.2</max_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>

      <max_linear_acceleration>0.8</max_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>

    </plugin>


    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">

      <topic>/joint_states</topic>

      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>lift_joint</joint_name>

      <joint_name>scissor_left_a_joint</joint_name>
      <joint_name>scissor_left_b_joint</joint_name>
      <joint_name>scissor_right_a_joint</joint_name>
      <joint_name>scissor_right_b_joint</joint_name>

    </plugin>

  </gazebo>


  <!-- ================================================================ -->
  <!-- MAIN LIFT POSITION CONTROLLER                                    -->
  <!-- ================================================================ -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>lift_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>/lift_position</topic>

      <p_gain>5000.0</p_gain>
      <i_gain>10.0</i_gain>
      <d_gain>150.0</d_gain>

      <i_max>100.0</i_max>
      <i_min>-100.0</i_min>

    </plugin>

  </gazebo>


  <!-- ================================================================ -->
  <!-- FOUR SCISSOR JOINT CONTROLLERS                                   -->
  <!-- ================================================================ -->

  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>scissor_left_a_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>/scissor_left_a_position</topic>

      <p_gain>800.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>

    </plugin>

  </gazebo>


  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>scissor_left_b_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>/scissor_left_b_position</topic>

      <p_gain>800.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>

    </plugin>

  </gazebo>


  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>scissor_right_a_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>/scissor_right_a_position</topic>

      <p_gain>800.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>

    </plugin>

  </gazebo>


  <gazebo>

    <plugin
      filename="ignition-gazebo-joint-position-controller-system"
      name="ignition::gazebo::systems::JointPositionController">

      <joint_name>scissor_right_b_joint</joint_name>
      <joint_index>0</joint_index>

      <topic>/scissor_right_b_position</topic>

      <p_gain>800.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>20.0</d_gain>

    </plugin>

  </gazebo>

</robot>